// =====================================================
// CONECTAR WIFI
// =====================================================

void conectarWiFi() {

  Serial.println();
  Serial.println(
    "================================"
  );

  Serial.println(
    "CONECTANDO WIFI"
  );

  Serial.println(
    "================================"
  );

  Serial.print(
    "SSID: "
  );

  Serial.println(
    wifiSSID
  );

  WiFi.disconnect(
    true
  );

  delay(300);

  WiFi.mode(
    WIFI_STA
  );

  WiFi.begin(
    wifiSSID.c_str(),
    wifiPassword.c_str()
  );

  unsigned long inicio =
    millis();

  while (
    WiFi.status() != WL_CONNECTED &&
    millis() - inicio < 15000
  ) {

    delay(500);

    Serial.print(
      "."
    );
  }

  Serial.println();

  if (
    WiFi.status() ==
    WL_CONNECTED
  ) {

    modoConfiguracion =
      false;

    dnsServer.stop();

    Serial.println(
      "WIFI CONECTADO"
    );

    Serial.print(
      "IP: "
    );

    Serial.println(
      WiFi.localIP()
    );

    Serial.print(
      "RSSI: "
    );

    Serial.print(
      WiFi.RSSI()
    );

    Serial.println(
      " dBm"
    );

    configTime(
      GMT_OFFSET_SEC,
      DAYLIGHT_OFFSET_SEC,
      NTP_SERVER
    );

    mostrarIP();

    iniciarServidor();

    return;
  }

  Serial.println(
    "NO SE PUDO CONECTAR"
  );

  iniciarModoConfiguracion();
}

// =====================================================
// UID A STRING
// =====================================================

String uidToString(
  uint8_t* uid,
  uint8_t uidLength
) {

  String resultado = "";

  for (
    uint8_t i = 0;
    i < uidLength;
    i++
  ) {

    if (
      uid[i] < 0x10
    ) {

      resultado +=
        "0";
    }

    if (i > 0) {

      resultado +=
        ":";
    }

    resultado +=
      String(
        uid[i],
        HEX
      );
  }

  resultado.toUpperCase();

  return resultado;
}

// =====================================================
// ESPERAR RETIRO
// =====================================================

void esperarRetiroTarjeta() {

  uint8_t uid[7];

  uint8_t uidLength;

  while (true) {

    bool detectada =
      nfc.readPassiveTargetID(
        PN532_MIFARE_ISO14443A,
        uid,
        &uidLength,
        100
      );

    if (!detectada) {

      break;
    }

    delay(100);
  }
}

// =====================================================
// PROCESAR TARJETA
// =====================================================

void procesarTarjeta(
  uint8_t* uid,
  uint8_t uidLength
) {

  String uidTexto =
    uidToString(
      uid,
      uidLength
    );

  Serial.println();
  Serial.println(
    "=============================="
  );

  Serial.println(
    "TARJETA DETECTADA"
  );

  Serial.print(
    "UID: "
  );

  Serial.println(
    uidTexto
  );

  pantallaLeyendo();

  delay(300);

  Persona persona;

  if (
    !buscarPersona(
      uidTexto,
      persona
    )
  ) {

    Serial.println(
      "PERSONA NO REGISTRADA"
    );

    guardarRegistro(
      uidTexto,
      "",
      "",
      "",
      "NO_REGISTRADA"
    );

    pantallaDenegado();

    beepLargo();

    delay(1500);

    pantallaEspera();

    esperarRetiroTarjeta();

    return;
  }

  if (
    persona.activo != "SI" &&
    persona.activo != "si" &&
    persona.activo != "Si"
  ) {

    Serial.println(
      "PERSONA INACTIVA"
    );

    guardarRegistro(
      uidTexto,
      persona.nombre,
      persona.grupo,
      persona.tipo,
      "INACTIVA"
    );

    pantallaDenegado();

    beepLargo();

    delay(1500);

    pantallaEspera();

    esperarRetiroTarjeta();

    return;
  }

  Serial.println(
    "PERSONA ENCONTRADA"
  );

  Serial.print(
    "Nombre: "
  );

  Serial.println(
    persona.nombre
  );

  Serial.print(
    "Grupo: "
  );

  Serial.println(
    persona.grupo
  );

  Serial.print(
    "Tipo: "
  );

  Serial.println(
    persona.tipo
  );

  guardarRegistro(
    uidTexto,
    persona.nombre,
    persona.grupo,
    persona.tipo,
    "AUTORIZADO"
  );

  pantallaAutorizado(
    persona.nombre,
    persona.grupo
  );

  beepCorto();

  delay(2000);

  pantallaEspera();

  esperarRetiroTarjeta();
}

// =====================================================
// SETUP
// =====================================================

void setup() {

  Serial.begin(
    115200
  );

  delay(1000);

  Serial.println();
  Serial.println(
    "======================================"
  );

  Serial.println(
    "        TERMINAL NFC BASE 1.2"
  );

  Serial.println(
    "======================================"
  );

  // ---------------------------------
  // BUZZER
  // ---------------------------------

  pinMode(
    BUZZER_PIN,
    OUTPUT
  );

  digitalWrite(
    BUZZER_PIN,
    HIGH
  );

  // ---------------------------------
  // I2C
  // ---------------------------------

  Wire.begin(
    SDA_PIN,
    SCL_PIN
  );

  // ---------------------------------
  // OLED
  // ---------------------------------

  display.begin();

  display.clearBuffer();

  display.setFont(
    u8g2_font_6x10_tf
  );

  display.drawStr(
    27,
    31,
    "INICIANDO..."
  );

  display.sendBuffer();

  delay(700);

  Serial.println(
    "OLED SH1106 OK"
  );

  // ---------------------------------
  // PN532
  // ---------------------------------

  nfc.begin();

  uint32_t versiondata =
    nfc.getFirmwareVersion();

  if (
    !versiondata
  ) {

    Serial.println(
      "ERROR: PN532"
    );

    pn532_OK =
      false;

  } else {

    pn532_OK =
      true;

    Serial.println(
      "PN532 OK"
    );

    uint8_t version =
      (versiondata >> 24) & 0xFF;

    uint8_t major =
      (versiondata >> 16) & 0xFF;

    uint8_t minor =
      (versiondata >> 8) & 0xFF;

    Serial.print(
      "Firmware PN532: "
    );

    Serial.print(
      major
    );

    Serial.print(
      "."
    );

    Serial.println(
      minor
    );

    nfc.SAMConfig();
  }

  // ---------------------------------
  // MICROSD
  // ---------------------------------

  iniciarMicroSD();

  if (microSD_OK) {

    prepararArchivos();
  }

  // ---------------------------------
  // BEEP ARRANQUE
  // ---------------------------------

  beepsArranque();

  // ---------------------------------
  // WIFI
  // ---------------------------------

  if (
    cargarWiFi()
  ) {

    Serial.println();
    Serial.println(
      "LEYENDO WIFI GUARDADO"
    );

    Serial.println(
      "================================"
    );

    Serial.print(
      "SSID guardado: "
    );

    Serial.println(
      wifiSSID
    );

    WiFi.mode(
      WIFI_STA
    );

    WiFi.begin(
      wifiSSID.c_str(),
      wifiPassword.c_str()
    );

    unsigned long inicio =
      millis();

    while (
      WiFi.status() != WL_CONNECTED &&
      millis() - inicio < 15000
    ) {

      delay(500);

      Serial.print(
        "."
      );
    }

    Serial.println();

    if (
      WiFi.status() ==
      WL_CONNECTED
    ) {

      modoConfiguracion =
        false;

      Serial.println(
        "WIFI CONECTADO"
      );

      Serial.print(
        "IP: "
      );

      Serial.println(
        WiFi.localIP()
      );

      Serial.print(
        "RSSI: "
      );

      Serial.print(
        WiFi.RSSI()
      );

      Serial.println(
        " dBm"
      );

      configTime(
        GMT_OFFSET_SEC,
        DAYLIGHT_OFFSET_SEC,
        NTP_SERVER
      );

      iniciarServidor();

      mostrarIP();

      delay(5000);

      pantallaEspera();

    } else {

      Serial.println(
        "NO SE PUDO CONECTAR"
      );

      iniciarModoConfiguracion();
    }

  } else {

    iniciarModoConfiguracion();
  }

  Serial.println();
  Serial.println(
    "================================================"
  );

  Serial.println(
    "              SISTEMA LISTO"
  );

  Serial.println(
    "================================================"
  );
}

// =====================================================
// LOOP
// =====================================================

void loop() {

  // ---------------------------------
  // DNS
  // ---------------------------------

  if (
    modoConfiguracion
  ) {

    dnsServer.processNextRequest();
  }

  // ---------------------------------
  // WEB
  // ---------------------------------

  server.handleClient();

  // ---------------------------------
  // NFC
  // ---------------------------------

  if (!pn532_OK) {

    delay(100);

    return;
  }

  uint8_t uid[7];

  uint8_t uidLength;

  bool detectada =
    nfc.readPassiveTargetID(
      PN532_MIFARE_ISO14443A,
      uid,
      &uidLength,
      100
    );

  if (
    detectada
  ) {

    procesarTarjeta(
      uid,
      uidLength
    );
  }
}



