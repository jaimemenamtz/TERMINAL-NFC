// =====================================================
// SERVIDOR
// =====================================================

void iniciarServidor() {

  server.on(
    "/",
    HTTP_GET,
    handleRoot
  );

  server.on(
    "/config",
    HTTP_GET,
    handleConfig
  );

  server.on(
    "/guardar",
    HTTP_POST,
    guardarWiFiWeb
  );

  server.on(
    "/personas",
    HTTP_GET,
    []() {

      server.send(
        200,
        "text/html; charset=utf-8",
        paginaPersonas()
      );
    }
  );

  server.on(
    "/personas_subir",
    HTTP_GET,
    []() {

      server.send(
        200,
        "text/html; charset=utf-8",
        paginaSubirPersonas()
      );
    }
  );

  server.on(
    "/subir_personas",
    HTTP_POST,
    finalizarUploadPersonas,
    manejarUploadPersonas
  );

  server.on(
    "/registros",
    HTTP_GET,
    []() {

      server.send(
        200,
        "text/html; charset=utf-8",
        paginaRegistros()
      );
    }
  );

  server.on(
    "/descargar-registros",
    HTTP_GET,
    descargarRegistros
  );

  // Android

  server.on(
    "/generate_204",
    HTTP_GET,
    redireccionPortal
  );

  server.on(
    "/gen_204",
    HTTP_GET,
    redireccionPortal
  );

  server.on(
    "/connectivitycheck/generate_204",
    HTTP_GET,
    redireccionPortal
  );

  // Apple

  server.on(
    "/hotspot-detect.html",
    HTTP_GET,
    redireccionPortal
  );

  server.on(
    "/library/test/success.html",
    HTTP_GET,
    redireccionPortal
  );

  // Windows

  server.on(
    "/ncsi.txt",
    HTTP_GET,
    redireccionPortal
  );

  server.on(
    "/connecttest.txt",
    HTTP_GET,
    redireccionPortal
  );

  server.onNotFound(
    []() {

      if (
        modoConfiguracion
      ) {

        redireccionPortal();

      } else {

        server.send(
          404,
          "text/plain",
          "404"
        );
      }
    }
  );

  server.begin();

  Serial.println(
    "Servidor HTTP iniciado"
  );
}

