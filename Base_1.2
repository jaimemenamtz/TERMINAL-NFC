// =====================================================
// CONTAR LINEAS
// =====================================================

int contarLineas(
  const char* archivoNombre
) {

  if (!microSD_OK) {

    return 0;
  }

  File archivo =
    SD.open(
      archivoNombre,
      FILE_READ
    );

  if (!archivo) {

    return 0;
  }

  int contador = 0;

  while (
    archivo.available()
  ) {

    String linea =
      archivo.readStringUntil(
        '\n'
      );

    linea.trim();

    if (
      linea.length() > 0
    ) {

      contador++;
    }
  }

  archivo.close();

  // Restar encabezado

  if (contador > 0) {

    contador--;
  }

  return contador;
}

// =====================================================
// SEPARAR CSV SIMPLE
// =====================================================

bool separarCSV(
  String linea,
  String campos[],
  int cantidad
) {

  int inicio = 0;

  for (
    int i = 0;
    i < cantidad;
    i++
  ) {

    int posicion =
      linea.indexOf(
        ',',
        inicio
      );

    if (
      posicion == -1
    ) {

      if (
        i == cantidad - 1
      ) {

        campos[i] =
          linea.substring(
            inicio
          );

        campos[i].trim();

        return true;
      }

      return false;
    }

    campos[i] =
      linea.substring(
        inicio,
        posicion
      );

    campos[i].trim();

    inicio =
      posicion + 1;
  }

  return true;
}

// =====================================================
// BUSCAR PERSONA
// =====================================================

bool buscarPersona(
  String uid,
  Persona &persona
) {

  if (!microSD_OK) {

    return false;
  }

  File archivo =
    SD.open(
      ARCHIVO_PERSONAS,
      FILE_READ
    );

  if (!archivo) {

    return false;
  }

  // Saltar encabezado

  archivo.readStringUntil(
    '\n'
  );

  while (
    archivo.available()
  ) {

    String linea =
      archivo.readStringUntil(
        '\n'
      );

    linea.trim();

    if (
      linea.length() == 0
    ) {

      continue;
    }

    String campos[7];

    if (
      !separarCSV(
        linea,
        campos,
        7
      )
    ) {

      continue;
    }

    String uidCSV =
      campos[0];

    uidCSV.trim();

    uidCSV.toUpperCase();

    String uidBuscar =
      uid;

    uidBuscar.toUpperCase();

    if (
      uidCSV == uidBuscar
    ) {

      persona.uid =
        campos[0];

      persona.nombre =
        campos[1];

      persona.grupo =
        campos[2];

      persona.tipo =
        campos[3];

      persona.horaEntrada =
        campos[4];

      persona.horaSalida =
        campos[5];

      persona.activo =
        campos[6];

      archivo.close();

      return true;
    }
  }

  archivo.close();

  return false;
}

// =====================================================
// FECHA Y HORA
// =====================================================

String obtenerFecha() {

  struct tm timeinfo;

  if (
    !getLocalTime(
      &timeinfo,
      100
    )
  ) {

    horaOK = false;

    return "SIN_FECHA";
  }

  horaOK = true;

  char buffer[20];

  strftime(
    buffer,
    sizeof(buffer),
    "%d/%m/%Y",
    &timeinfo
  );

  return String(
    buffer
  );
}


String obtenerHora() {

  struct tm timeinfo;

  if (
    !getLocalTime(
      &timeinfo,
      100
    )
  ) {

    horaOK = false;

    return "SIN_HORA";
  }

  horaOK = true;

  char buffer[20];

  strftime(
    buffer,
    sizeof(buffer),
    "%H:%M:%S",
    &timeinfo
  );

  return String(
    buffer
  );
}

// =====================================================
// SIGUIENTE ID
// =====================================================

long siguienteID() {

  if (!microSD_OK) {

    return 1;
  }

  File archivo =
    SD.open(
      ARCHIVO_REGISTROS,
      FILE_READ
    );

  if (!archivo) {

    return 1;
  }

  archivo.readStringUntil(
    '\n'
  );

  long ultimo = 0;

  while (
    archivo.available()
  ) {

    String linea =
      archivo.readStringUntil(
        '\n'
      );

    linea.trim();

    if (
      linea.length() == 0
    ) {

      continue;
    }

    int coma =
      linea.indexOf(',');

    if (
      coma > 0
    ) {

      long id =
        linea.substring(
          0,
          coma
        ).toInt();

      if (
        id > ultimo
      ) {

        ultimo = id;
      }
    }
  }

  archivo.close();

  return ultimo + 1;
}

// =====================================================
// GUARDAR REGISTRO
// =====================================================

bool guardarRegistro(
  String uid,
  String nombre,
  String grupo,
  String tipo,
  String resultado
) {

  if (!microSD_OK) {

    return false;
  }

  File archivo =
    SD.open(
      ARCHIVO_REGISTROS,
      FILE_APPEND
    );

  if (!archivo) {

    Serial.println(
      "ERROR abriendo registros.csv"
    );

    return false;
  }

  long id =
    siguienteID();

  String fecha =
    obtenerFecha();

  String hora =
    obtenerHora();

  archivo.print(
    id
  );

  archivo.print(',');

  archivo.print(
    fecha
  );

  archivo.print(',');

  archivo.print(
    hora
  );

  archivo.print(',');

  archivo.print(
    uid
  );

  archivo.print(',');

  archivo.print(
    nombre
  );

  archivo.print(',');

  archivo.print(
    grupo
  );

  archivo.print(',');

  archivo.print(
    tipo
  );

  archivo.print(',');

  archivo.print(
    resultado
  );

  archivo.print(',');

  archivo.println(
    "NO"
  );

  archivo.close();

  Serial.println(
    "Registro guardado"
  );

  return true;
}

