// =====================================================
// BUZZER
// =====================================================

void beepCorto() {

  digitalWrite(
    BUZZER_PIN,
    LOW
  );

  delay(100);

  digitalWrite(
    BUZZER_PIN,
    HIGH
  );
}


void beepLargo() {

  digitalWrite(
    BUZZER_PIN,
    LOW
  );

  delay(500);

  digitalWrite(
    BUZZER_PIN,
    HIGH
  );
}


void beepsArranque() {

  for (int i = 0; i < 4; i++) {

    beepCorto();

    delay(100);
  }

  delay(500);

  beepLargo();
}

// =====================================================
// ICONO WIFI
// =====================================================

void dibujarWiFi(
  int x,
  int y
) {

  if (WiFi.status() != WL_CONNECTED) {

    display.drawCircle(
      x,
      y,
      2
    );

    display.drawLine(
      x - 8,
      y - 7,
      x + 8,
      y + 7
    );

    display.drawLine(
      x + 8,
      y - 7,
      x - 8,
      y + 7
    );

    return;
  }

  int rssi = WiFi.RSSI();

  int nivel = 1;

  if (rssi > -55) {

    nivel = 4;

  } else if (rssi > -67) {

    nivel = 3;

  } else if (rssi > -80) {

    nivel = 2;

  } else {

    nivel = 1;
  }

  // Punto central

  display.drawDisc(
    x,
    y,
    2
  );

  // Nivel 1

  if (nivel >= 1) {

    display.drawLine(
      x - 5,
      y - 2,
      x,
      y + 3
    );

    display.drawLine(
      x,
      y + 3,
      x + 5,
      y - 2
    );
  }

  // Nivel 2

  if (nivel >= 2) {

    display.drawLine(
      x - 9,
      y - 6,
      x - 4,
      y - 1
    );

    display.drawLine(
      x + 4,
      y - 1,
      x + 9,
      y - 6
    );
  }

  // Nivel 3

  if (nivel >= 3) {

    display.drawLine(
      x - 12,
      y - 10,
      x - 7,
      y - 5
    );

    display.drawLine(
      x + 7,
      y - 5,
      x + 12,
      y - 10
    );
  }

  // Nivel 4

  if (nivel >= 4) {

    display.drawLine(
      x - 15,
      y - 13,
      x - 10,
      y - 8
    );

    display.drawLine(
      x + 10,
      y - 8,
      x + 15,
      y - 13
    );
  }
}

