// =====================================================
// GUARDAR WIFI
// =====================================================

void guardarWiFi(
  String ssid,
  String password
) {

  preferences.begin(
    "wifi",
    false
  );

  preferences.putString(
    "ssid",
    ssid
  );

  preferences.putString(
    "pass",
    password
  );

  preferences.end();

  wifiSSID =
    ssid;

  wifiPassword =
    password;
}

// =====================================================
// CARGAR WIFI
// =====================================================

bool cargarWiFi() {

  preferences.begin(
    "wifi",
    true
  );

  wifiSSID =
    preferences.getString(
      "ssid",
      ""
    );

  wifiPassword =
    preferences.getString(
      "pass",
      ""
    );

  preferences.end();

  return (
    wifiSSID.length() > 0
  );
}

// =====================================================
// MICROSD
// =====================================================

bool iniciarMicroSD() {

  Serial.println();
  Serial.println(
    "================================"
  );

  Serial.println(
    "INICIANDO MICROSD"
  );

  Serial.println(
    "================================"
  );

  // EXACTAMENTE la configuración
  // que acabamos de probar

  spiSD.begin(
    SD_SCK,
    SD_MISO,
    SD_MOSI,
    SD_CS
  );

  Serial.println(
    "SPI microSD iniciado"
  );

  if (
    !SD.begin(
      SD_CS,
      spiSD,
      10000000
    )
  ) {

    Serial.println(
      "ERROR: microSD"
    );

    microSD_OK =
      false;

    return false;
  }

  microSD_OK =
    true;

  Serial.println(
    "microSD OK"
  );

  Serial.print(
    "Capacidad: "
  );

  Serial.print(
    SD.cardSize() /
    (1024 * 1024)
  );

  Serial.println(
    " MB"
  );

  return true;
}

