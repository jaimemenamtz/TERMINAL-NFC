// =====================================================

void guardarWiFiWeb() {

  String ssid =
    server.arg(
      "ssid"
    );

  String ssidManual =
    server.arg(
      "ssid_manual"
    );

  String password =
    server.arg(
      "password"
    );

  if (
    ssidManual.length() > 0
  ) {

    ssid =
      ssidManual;
  }

  if (
    ssid.length() == 0
  ) {

    server.send(
      400,
      "text/plain",
      "SSID vacio"
    );

    return;
  }

  guardarWiFi(
    ssid,
    password
  );

  server.send(
    200,
    "text/html; charset=utf-8",
    "<h2>Guardado</h2>"
    "<p>Intentando conectar...</p>"
  );

  delay(1000);

  conectarWiFi();
}

// =====================================================
// SUBIDA DE PERSONAS
// =====================================================

File archivoUpload;
bool uploadOK = false;

// =====================================================
// PROCESAR UPLOAD
// =====================================================

void manejarUploadPersonas() {

  HTTPUpload& upload =
    server.upload();

  if (
    upload.status ==
    UPLOAD_FILE_START
  ) {

    Serial.print(
      "Subiendo: "
    );

    Serial.println(
      upload.filename
    );

    if (!microSD_OK) {

      uploadOK = false;

      return;
    }

    if (
      SD.exists(
        ARCHIVO_TEMP
      )
    ) {

      SD.remove(
        ARCHIVO_TEMP
      );
    }

    archivoUpload =
      SD.open(
        ARCHIVO_TEMP,
        FILE_WRITE
      );

    uploadOK =
      archivoUpload ? true : false;
  }

  else if (
    upload.status ==
    UPLOAD_FILE_WRITE
  ) {

    if (
      uploadOK &&
      archivoUpload
    ) {

      archivoUpload.write(
        upload.buf,
        upload.currentSize
      );
    }
  }

  else if (
    upload.status ==
    UPLOAD_FILE_END
  ) {

    if (
      archivoUpload
    ) {

      archivoUpload.close();
    }

    Serial.print(
      "Bytes recibidos: "
    );

    Serial.println(
      upload.totalSize
    );
  }

  else if (
    upload.status ==
    UPLOAD_FILE_ABORTED
  ) {

    if (
      archivoUpload
    ) {

      archivoUpload.close();
    }

    uploadOK = false;
  }
}

// =====================================================
// FINALIZAR UPLOAD
// =====================================================

void finalizarUploadPersonas() {

  if (
    !uploadOK
  ) {

    server.send(
      500,
      "text/html",
      "<h2>Error subiendo archivo</h2>"
    );

    return;
  }

  // Validar encabezado

  File archivo =
    SD.open(
      ARCHIVO_TEMP,
      FILE_READ
    );

  if (!archivo) {

    server.send(
      500,
      "text/html",
      "<h2>Error abriendo archivo temporal</h2>"
    );

    return;
  }

  String encabezado =
    archivo.readStringUntil(
      '\n'
    );

  encabezado.trim();

  archivo.close();

  if (
    !encabezado.startsWith(
      "UID,NOMBRE,GRUPO,TIPO"
    )
  ) {

    SD.remove(
      ARCHIVO_TEMP
    );

    server.send(
      400,
      "text/html",
      "<h2>CSV no valido</h2>"
    );

    return;
  }

  if (
    SD.exists(
      ARCHIVO_PERSONAS
    )
  ) {

    SD.remove(
      ARCHIVO_PERSONAS
    );
  }

  if (
    !SD.rename(
      ARCHIVO_TEMP,
      ARCHIVO_PERSONAS
    )
  ) {

    server.send(
      500,
      "text/html",
      "<h2>No se pudo reemplazar personas.csv</h2>"
    );

    return;
  }

  server.send(
    200,
    "text/html; charset=utf-8",
    "<h2>Personas cargadas correctamente</h2>"
    "<p><a href='/personas'>Ver personas</a></p>"
  );
}

